# Vistral-7B-Chat — LLM tiếng Việt (Viet-Mistral)
# GGUF: tải bởi scripts/install/06_models_download.sh
# Tạo model: ollama create vistral-7b-chat -f models/llm/Modelfile.vistral

FROM ./vistral-7b-chat-q4.gguf

# Vistral dùng chat template kiểu Llama-2 (<<SYS>> block) trên nền Mistral
TEMPLATE """{{- if .Messages }}
{{- range $i, $m := .Messages }}
{{- if eq $m.Role "system" }}<s>[INST] <<SYS>>
{{ $m.Content }}
<</SYS>>

{{ else if eq $m.Role "user" }}{{ if $i }}<s>[INST] {{ end }}{{ $m.Content }} [/INST] {{ else if eq $m.Role "assistant" }}{{ $m.Content }}</s>{{ end }}
{{- end }}
{{- else }}<s>[INST] <<SYS>>
{{ .System }}
<</SYS>>

{{ .Prompt }} [/INST] {{ end }}"""

PARAMETER stop "[INST]"
PARAMETER stop "[/INST]"
PARAMETER stop "</s>"
PARAMETER stop "Khách:"
PARAMETER num_ctx 2048
PARAMETER temperature 0.7
