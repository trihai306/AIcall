# ============================================
# AI Banking Call System - Configuration
# ============================================
# Copy this file to .env and adjust values

# --- STT: PhoWhisper (VinAI, thuần Việt) ---
# Live calls can use local Gipformer FP32. Install requirements below, stage
# the model, then select gipformer. PhoWhisper stays available for word timings.
# pip install -r whisper_server/requirements-gipformer.txt
STT_ENGINE=phowhisper
GIPFORMER_MODEL_PATH=./models/stt/gipformer1.5-fp32
GIPFORMER_NUM_THREADS=4
WHISPER_SERVER_URL=http://localhost:8178
WHISPER_MODEL=vinai/PhoWhisper-small
# Options: vinai/PhoWhisper-tiny, vinai/PhoWhisper-small (khuyến nghị), vinai/PhoWhisper-medium

# --- Ollama LLM: Qwen 3.5 9B ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
LLM_NUM_CTX=8192
# Fallback options: qwen2.5:7b, qwen3.5:4b

# --- F5-TTS ---
# Sau khi fine-tune giọng riêng, đổi CKPT_PATH sang models/tts/finetuned/<voice_name>/model_last.pt
F5TTS_CKPT_PATH=./models/tts/F5-TTS-Vietnamese-ViVoice/model_last.pt
F5TTS_VOCAB_PATH=./models/tts/F5-TTS-Vietnamese-ViVoice/vocab.txt
F5TTS_REF_AUDIO=./models/tts/ref_voices/default.wav
F5TTS_REF_TEXT=xin chào, tôi là nhân viên tư vấn ngân hàng
F5TTS_NFE_STEP=16
F5TTS_NFE_STEP_FIRST=16
F5TTS_SPEED=1.0

# --- Database ---
# Lịch sử cuộc gọi (session, hội thoại, latency). Xoá file này = mất lịch sử,
# app tự tạo lại khi khởi động.
DB_PATH=./data/app.db

# --- RAG ---
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
# cpu = nhường VRAM cho STT/LLM/TTS (khuyến nghị với GPU 12GB)
EMBEDDING_DEVICE=cpu

# --- VAD ---
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=220

# --- Pipeline ---
TTS_CHUNK_WORDS=8
TTS_FIRST_CHUNK_WORDS=4
LLM_MAX_TOKENS=80
LLM_TEMPERATURE=0.3

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Banking Config ---
BANK_NAME=Ngân hàng ABC
AGENT_NAME=Lan
